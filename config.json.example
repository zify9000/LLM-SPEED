      "label": "云端兼容网关（示例）",
      "gateway_url": "https://api.example.com/v1"
    },
    {
      "name": "cloud-long",
      "label": "云端长上下文（示例：只需声明上限，不必填部署卡）",
      "gateway_url": "https://api.example.com/v1",
      "model_profiles": [

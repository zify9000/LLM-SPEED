{
  "_comment": "gateway_url 为单地址旧写法（仍兼容）；gateway_urls 为多地址——本地部署可把内网/隧道地址都配上，测速时按配置顺序取第一个可达地址（顺序即优先级，优选排前）",
  "providers": [
    {
      "name": "deepseek",
      "label": "DeepSeek 云端",
      "gateway_url": "https://api.deepseek.com"
    },
    {
      "name": "qwen",
      "label": "Qwen 云端",
      "gateway_url": "https://token-plan.cn-beijing.maas.aliyuncs.com/compatible-mode"
    },
    {
      "name": "kimi",
      "label": "Kimi 云端",
      "gateway_url": "https://api.kimi.com/coding",
      "deployments": [
        {
          "label": "Kimi K3",
          "models": ["k3-256k"],
          "max_ctx": 262144
        }
      ]
    },
    {
      "name": "local",
      "label": "本地网关（LiteLLM）",
      "gateway_urls": [
        "http://127.0.0.1:4000"
      ],
      "local": true,
      "deployments": [
        {
          "label": "示例部署",
          "models": ["your-model-name"],
          "quant": "Q8_0",
          "hardware": "示例：按实际填写",
          "framework": "llama.cpp",
          "params": "-c 196608 -b 16384 --cache-type-k/v q8_0",
          "max_ctx": 196608
        }
      ]
    }
  ]
}

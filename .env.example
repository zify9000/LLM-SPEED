# 复制为 .env 并填入真实值：  cp .env.example .env
# .env 已在 .gitignore 中，切勿提交到版本库
# key 只由服务端读取（Authorization header），不下发前端、不拼 URL、不落盘

# ===== 分 provider 的 API Key =====
# 命名规则：API_KEY_<PROVIDER名称大写>，provider 名称在 config.json 的 providers 中定义
API_KEY_DEEPSEEK=
API_KEY_LOCAL=

# ===== 全局兜底 Key（某 provider 无专属 key 时使用）=====
API_KEY=

# ===== 监听地址（可选）=====
# 缺省绑定 127.0.0.1:8501（仅本机）。全端点无鉴权：绑 0.0.0.0 会让局域网内
# 任何人可触发对云端付费网关的测速并删除历史，确需共享时自行评估风险
# HOST=127.0.0.1
# PORT=8501

# ===== 允许访问的主机名（可选；HOST=0.0.0.0 时必须显式放行）=====
# 写接口校验 Host 与同源：防 DNS rebinding 之类"把页面变成同源"的攻击改写
# provider 网关地址、进而把 API Key 发到第三方。缺省只允许
# 127.0.0.1 / localhost / [::1]；绑 0.0.0.0 从别的机器访问时，把访问用的
# 主机名或 IP 写进来（逗号分隔）：
# ALLOWED_HOSTS=192.168.1.10,llm-box.local
# 本文件只含 Key，权限应为 0600；start.sh / start.bat 会自动收紧
